. postfile results str14 outcome str12 specification str8 vce ///
>     double(N clusters ols_b ols_se iv_b iv_se iv_p first_b first_se first_F first_p partial_R2 ///
>     endog_F endog_p AR0_F AR0_p AR_A AR_B AR_C AR_critical) ///
>     using endogeneity_results.dta, replace

. foreach y in Y_actual Y_frontier Y_actual_w Y_frontier_w {
  2.     foreach spec in baseline province age {
  3.         local X "ln_pop0 edu0 ln_budget0"
  4.         if "`spec'"=="province" local X "`X' i.province"
  5.         if "`spec'"=="age" local X "`X' age0 age0_sq"
  6.         foreach vc in HC1 province {
  7.             local V "robust"
  8.             if "`vc'"=="province" local V "cluster province"
  9.             quietly regress `y' D `X', vce(`V')
 10.             scalar ob=_b[D]
 11.             scalar os=_se[D]
 12.             scalar NN=e(N)
 13.             scalar GG=.
 14.             if "`vc'"=="province" scalar GG=e(N_clust)
 15. 
.             * 第一阶段：只检验排除工具Z，而不是整条方程的总体F。
.             * 设计矩阵维度不能用聚类VCE的rank代替（后者可能小于参数数目）。
.             quietly regress D Z `X'
 16.             scalar kq=e(rank)
 17.             quietly regress D Z `X', vce(`V')
 18.             scalar fb=_b[Z]
 19.             scalar fs=_se[Z]
 20.             scalar fsrss=e(rss)
 21.             scalar dfr=e(df_r)
 22.             predict double vhat, residuals
 23.             test Z
 24.             scalar ff=r(F)
 25.             scalar fp=r(p)
 26.             quietly regress D `X'
 27.             scalar pr2=1-fsrss/e(rss)
 28. 
.             * 原生2SLS标准误；不能把第一阶段拟合值直接拿去普通OLS。
.             ivregress 2sls `y' `X' (D=Z), vce(`V') small
 29.             scalar ib=_b[D]
 30.             scalar ise=_se[D]
 31.             test D
 32.             scalar ip=r(p)
 33.             estat endogenous
 34.             scalar ef=r(regF)
 35.             scalar ep=r(p_regF)
 36. 
.             * AR检验H0:beta=0。与内生性检验H0:D外生不同。
.             quietly regress `y' Z `X', vce(`V')
 37.             scalar ry=_b[Z]
 38.             scalar vy=_se[Z]^2
 39.             predict double ey, residuals
 40.             test Z
 41.             scalar af=r(F)
 42.             scalar ap=r(p)
 43.             scalar crit=invFtail(1,e(df_r),.05)
 44.             * 完整AR置信集合：解 A*beta^2+B*beta+C<=0，不设任意网格边界。
.             quietly regress Z `X'
 45.             predict double rz, residuals
 46.             quietly summarize rz
 47.             scalar zz=(r(N)-1)*r(Var)+r(N)*r(mean)^2
 48.             gen double sy=rz*ey/zz
 49.             gen double sd=rz*vhat/zz
 50.             if "`vc'"=="province" {
 51.                 bysort province: egen double cy=total(sy)
 52.                 bysort province: egen double cd=total(sd)
 53.                 egen byte tag=tag(province)
 54.                 gen double cross=cy*cd if tag
 55.                 scalar adj=GG/(GG-1)*(NN-1)/(NN-kq)
 56.             }
 57.             else {
 58.                 gen double cross=sy*sd
 59.                 scalar adj=NN/(NN-kq)
 60.             }
 61.             quietly summarize cross, meanonly
 62.             scalar vyd=adj*r(sum)
 63.             scalar aa=fb^2-crit*fs^2
 64.             scalar bb=-2*ry*fb+2*crit*vyd
 65.             scalar cc=ry^2-crit*vy
 66.             post results ("`y'") ("`spec'") ("`vc'") (NN) (GG) (ob) (os) ///
>                 (ib) (ise) (ip) (fb) (fs) (ff) (fp) (pr2) (ef) (ep) ///
>                 (af) (ap) (aa) (bb) (cc) (crit)
 67.             drop vhat ey rz sy sd cross
 68.             if "`vc'"=="province" drop cy cd tag
 69.         }
 70.     }
 71. }

